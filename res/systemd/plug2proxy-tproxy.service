[Unit]
Description=Plug2Proxy with native Linux TPROXY
Documentation=https://github.com/vilicvane/plug2proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=plug2proxy
Group=plug2proxy
StateDirectory=plug2proxy
StateDirectoryMode=0750
WorkingDirectory=/var/lib/plug2proxy
UMask=0077

Environment=RUST_LOG=info,plug2proxy=debug
ExecStart=/usr/sbin/plug2proxy --config /etc/plug2proxy/config.json
# The + prefix runs only the short-lived network controller as root. The
# long-running data plane remains the unprivileged process above.
ExecStartPost=+/usr/sbin/plug2proxy --config /etc/plug2proxy/config.json network apply
ExecReload=+/usr/sbin/plug2proxy --config /etc/plug2proxy/config.json network reconcile
# Fail open: stop interception before systemd terminates the data plane.
ExecStop=+/usr/sbin/plug2proxy network remove
ExecStopPost=-+/usr/sbin/plug2proxy network remove

AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
LimitNOFILE=65536

PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/var/lib/plug2proxy

Restart=on-failure
RestartSec=2s
TimeoutStartSec=600s
TimeoutStopSec=600s

[Install]
WantedBy=multi-user.target
